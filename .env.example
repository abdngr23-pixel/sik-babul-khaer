# ================================================================
# SIK-MBH: Variabel Lingkungan Produksi & Deployment (Environment)
# Masjid Babul Khaer Kompleks BTP Blok AE Tamalanrea Makassar
# ================================================================

# Mode Aplikasi
NODE_ENV=production
PORT=3000

# URL Domain Resmi Aplikasi (Sesuaikan dengan domain Vercel / VPS Anda)
# Contoh Vercel: https://sik-babul-khaer.vercel.app
# Contoh VPS/Domain Sendiri: https://sik.babulkhaer.or.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini AI API Key (Opsional / Dianjurkan)
# Digunakan untuk fitur: Ekstraksi Notulensi Rapat AI & Generator Draf Surat
# Dapatkan gratis di: https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...

# Jalur Berkas Basis Data SQLite Lokal (Opsional)
# Nilai bawaan di server VPS / Docker: data/sik_mbh.sqlite
# Nilai bawaan di Vercel: /tmp/sik_mbh.sqlite
# DATABASE_PATH=/app/data/sik_mbh.sqlite

# ================================================================
# Turso Cloud SQLite (Dianjurkan untuk Vercel Permanen - Zero Data Loss)
# Dapatkan gratis di: https://turso.tech (Free Tier 9GB, 500 DB, Region Singapore)
# ================================================================
TURSO_DATABASE_URL=libsql://sik-babul-khaer-xxxxx.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# ================================================================
# Keamanan Sesi Kriptografi (WAJIB - Wajib Diisi di Vercel / Server)
# Generate kunci 64-karakter acak dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ================================================================
AUTH_SECRET=d074586331045790bc4513d54e5243978ae38c44d33d7f2e28c619b0d6e83d9f

